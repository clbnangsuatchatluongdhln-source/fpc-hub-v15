{
  "name": "fpc-hub-v15",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run map:check && tsc && vite build",
    "map:update": "node scripts/update-project-map.mjs",
    "map:check": "node scripts/update-project-map.mjs --check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "tsc --noEmit && biome check src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vercel/node": "^26.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "@biomejs/biome": "2.6.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@supabase/supabase-js": "^2.118.0"
  }
}
